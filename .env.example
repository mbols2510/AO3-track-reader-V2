# Copy to .env and edit.  docker compose reads it automatically.

# Which version of the server images to run: "latest" follows every release
# (update with: docker compose pull && docker compose up -d), or pin one, e.g. 2.2.0.
AO3TRACK_VERSION=latest

# Shared secret between the two containers (tracker asks tracksync which works to refresh).
# Generate one with:  openssl rand -hex 32
INTERNAL_TOKEN=change-me-to-a-long-random-string

# User/group the containers run as. Only matters if you bind-mount host folders to /data
# (e.g. on a Synology/Unraid/TrueNAS box): set these to the owner of those folders.
# Find them over SSH with:  id <your-username>     (Synology admin is often 1026 / 100)
PUID=1000
PGID=1000

# 127.0.0.1 = only this PC can connect (safest).
# 0.0.0.0   = other devices on your network (phone, laptop) can reach it too.
BIND_ADDRESS=127.0.0.1
TRACKSYNC_PORT=8080
TRACKER_PORT=8081

# The address your devices use to reach TrackSync (shown in the dashboard).
TRACKSYNC_PUBLIC_URL=http://localhost:8080

# Set to false after creating your account(s) to stop anyone else signing up.
ALLOW_REGISTRATION=true

# Set to true if you put TrackSync behind a reverse proxy (Caddy, nginx, Traefik).
TRUST_PROXY=false

# --- AO3 politeness (the tracker never exceeds these) ---
RATE_BURST=2
RATE_REFILL_SECONDS=12
RATE_MIN_INTERVAL_SECONDS=2
RATE_PAUSE_MINUTES=5
CACHE_TTL_HOURS=6
REFRESH_INTERVAL_HOURS=6

# Optional: an AO3 session cookie so the tracker can see works restricted to logged-in users.
# (The desktop reader already uses your own AO3 login for those, so this is rarely needed.)
AO3_COOKIE=

# --- Desktop reader updates ---
# Lets the reader tell you about new versions and install them. The repository is private,
# so the tracker needs a read-only GitHub token: github.com -> Settings -> Developer settings
# -> Fine-grained tokens, only this repository, permission "Contents: Read-only".
GITHUB_TOKEN=
# GITHUB_REPO=mbols2510/AO3-track-reader-V2

# --- Remote access (docker-compose.caddy.yml or docker-compose.tunnel.yml) ---
SYNC_DOMAIN=sync.example.com
TRACKER_DOMAIN=tracker.example.com
# Let's Encrypt contact address (Caddy only).
ACME_EMAIL=you@example.com
# Required once the tracker is reachable from the internet. Generate: openssl rand -hex 24
TRACKER_API_KEY=
# Cloudflare Tunnel only: the token from Zero Trust -> Networks -> Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
