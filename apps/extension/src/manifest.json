{
  "manifest_version": 3,
  "name": "Ao3 Tracker",
  "short_name": "Ao3Track",
  "description": "Remembers exactly where you stopped reading on AO3, shows unread chapters, and syncs with your Ao3Track server.",
  "version": "2.2.0",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "content_scripts": [{
    "matches": ["*://archiveofourown.org/*", "*://www.archiveofourown.org/*"],
    "js": ["content.js"],
    "css": ["tracker.css"],
    "run_at": "document_end"
  }],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Ao3 Tracker", "default_popup": "options.html?popup=1" },
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "alarms"],
  "host_permissions": ["*://archiveofourown.org/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": { "gecko": { "id": "ao3track@ao3track.local", "strict_min_version": "128.0" } }
}
